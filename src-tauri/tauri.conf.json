{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "combot-telemetry",
  "version": "0.4.0",
  "identifier": "com.hyang.combot-telemetry",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "combot-telemetry",
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0Njk0NDgyMTYxOEE5OUUKUldTZXFSZ1dna1JwTk0wemVZc3pOUTVoakl5TWtPMzNMK2Jsa2JKbjJ3REZwQVkzRWUwMnZCWHQK",
      "endpoints": [
        "https://github.com/helenxuyang/combot-telemetry/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
