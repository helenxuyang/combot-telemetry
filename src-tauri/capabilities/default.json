{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    {
      "identifier": "fs:allow-app-write-recursive",
      "allow": [
        {
          "path": "$APPDATA/*"
        }
      ]
    },
    "dialog:default",
    "updater:default"
  ]
}
